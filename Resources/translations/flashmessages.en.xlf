<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="en" datatype="plaintext" original="HolidayBundleFlash">
    <body>
      <trans-unit id="h000" resname="holiday.error.comment_required">
        <source>holiday.error.comment_required</source>
        <target>A comment is required for absences.</target>
      </trans-unit>
      <trans-unit id="h001" resname="holiday.error.month_locked">
        <source>holiday.error.month_locked</source>
        <target>This month is locked and cannot be modified.</target>
      </trans-unit>
      <trans-unit id="h002" resname="holiday.error.timesheet_non_workday">
        <source>holiday.error.timesheet_non_workday</source>
        <target>Timesheets are restricted to contractual working days.</target>
      </trans-unit>
      <trans-unit id="h003" resname="holiday.error.ics_unknown_catalog">
        <source>holiday.error.ics_unknown_catalog</source>
        <target>Unknown holiday calendar.</target>
      </trans-unit>
      <trans-unit id="h004" resname="holiday.error.ics_invalid_url">
        <source>holiday.error.ics_invalid_url</source>
        <target>ICS URL must start with http:// or https://.</target>
      </trans-unit>
      <trans-unit id="h005" resname="holiday.error.ics_source_required">
        <source>holiday.error.ics_source_required</source>
        <target>Please select a holiday calendar or provide a custom ICS URL.</target>
      </trans-unit>
      <trans-unit id="h006" resname="holiday.error.ics_fetch_failed">
        <source>holiday.error.ics_fetch_failed</source>
        <target>Could not download or parse the ICS calendar.</target>
      </trans-unit>
      <trans-unit id="h007" resname="holiday.error.ics_url_required">
        <source>holiday.error.ics_url_required</source>
        <target>Please enter a custom ICS URL.</target>
      </trans-unit>
      <trans-unit id="h008" resname="holiday.error.ics_no_subscription">
        <source>holiday.error.ics_no_subscription</source>
        <target>This holiday group has no ICS subscription. Import from a calendar first.</target>
      </trans-unit>
      <trans-unit id="h009" resname="holiday.absence.edit.reapproval">
        <source>holiday.absence.edit.reapproval</source>
        <target>Absence updated. It must be approved again before it counts.</target>
      </trans-unit>
      <trans-unit id="h010" resname="holiday.absence.ics.regenerated">
        <source>holiday.absence.ics.regenerated</source>
        <target>Calendar link regenerated. Update any subscriptions with the new URL.</target>
      </trans-unit>
      <trans-unit id="h011" resname="holiday.error.invalid_date">
        <source>holiday.error.invalid_date</source>
        <target>Invalid date. Use the format YYYY-MM-DD.</target>
      </trans-unit>
      <trans-unit id="h012" resname="holiday.error.end_before_start">
        <source>holiday.error.end_before_start</source>
        <target>The end date must not be before the start date.</target>
      </trans-unit>
      <trans-unit id="h013" resname="holiday.error.range_too_long">
        <source>holiday.error.range_too_long</source>
        <target>An absence may cover at most one year.</target>
      </trans-unit>
      <trans-unit id="h014" resname="holiday.error.invalid_duration">
        <source>holiday.error.invalid_duration</source>
        <target>The duration must be between 0 and 24 hours.</target>
      </trans-unit>
      <trans-unit id="h015" resname="holiday.error.overlap">
        <source>holiday.error.overlap</source>
        <target>This absence overlaps with an existing absence.</target>
      </trans-unit>
      <trans-unit id="h020" resname="holiday.error.half_day_not_allowed">
        <source>holiday.error.half_day_not_allowed</source>
        <target>Half vacation days are not allowed.</target>
      </trans-unit>
      <trans-unit id="h016" resname="holiday.error.not_requested">
        <source>holiday.error.not_requested</source>
        <target>Only requested absences can be approved or rejected.</target>
      </trans-unit>
      <trans-unit id="h017" resname="holiday.error.invalid_type">
        <source>holiday.error.invalid_type</source>
        <target>Unknown absence type.</target>
      </trans-unit>
      <trans-unit id="h018" resname="holiday.error.invalid_json">
        <source>holiday.error.invalid_json</source>
        <target>Invalid JSON request body.</target>
      </trans-unit>
      <trans-unit id="h019" resname="holiday.error.invalid_comment">
        <source>holiday.error.invalid_comment</source>
        <target>The comment must be a string.</target>
      </trans-unit>
      <trans-unit id="h100" resname="holiday.error.self_approval">
        <source>holiday.error.self_approval</source>
        <target>You cannot approve your own absence. Another approver has to do it.</target>
      </trans-unit>
      <trans-unit id="h101" resname="holiday.error.exception_times_incomplete">
        <source>holiday.error.exception_times_incomplete</source>
        <target>Enter both times for special opening hours.</target>
      </trans-unit>
      <trans-unit id="h102" resname="holiday.error.exception_exists">
        <source>holiday.error.exception_exists</source>
        <target>There is already an exception for this date.</target>
      </trans-unit>
      <trans-unit id="h103" resname="holiday.error.group_in_use">
        <source>holiday.error.group_in_use</source>
        <target>The public holiday group is used by a location and cannot be deleted.</target>
      </trans-unit>
      <trans-unit id="h104" resname="holiday.error.extra_shift_exists">
        <source>holiday.error.extra_shift_exists</source>
        <target>There is already an extra shift on this day.</target>
      </trans-unit>
      <trans-unit id="h105" resname="holiday.error.extra_shift_on_workday">
        <source>holiday.error.extra_shift_on_workday</source>
        <target>No extra shift is needed on a working day.</target>
      </trans-unit>
      <trans-unit id="h106" resname="holiday.error.extra_shift_absent">
        <source>holiday.error.extra_shift_absent</source>
        <target>An approved absence covers this day.</target>
      </trans-unit>
      <trans-unit id="h107" resname="holiday.error.extra_shift_closed">
        <source>holiday.error.extra_shift_closed</source>
        <target>The location is closed on this day.</target>
      </trans-unit>
      <trans-unit id="h108" resname="holiday.extra_shift.created">
        <source>holiday.extra_shift.created</source>
        <target>Extra shift added.</target>
      </trans-unit>
      <trans-unit id="h109" resname="holiday.error.shift_same_day">
        <source>holiday.error.shift_same_day</source>
        <target>Source and target day must differ.</target>
      </trans-unit>
      <trans-unit id="h110" resname="holiday.error.shift_not_same_week">
        <source>holiday.error.shift_not_same_week</source>
        <target>The target day must be in the same week.</target>
      </trans-unit>
      <trans-unit id="h111" resname="holiday.error.shift_from_not_workday">
        <source>holiday.error.shift_from_not_workday</source>
        <target>The source day is not a workday or is a public holiday.</target>
      </trans-unit>
      <trans-unit id="h112" resname="holiday.error.shift_from_taken">
        <source>holiday.error.shift_from_taken</source>
        <target>The source day already has a shift.</target>
      </trans-unit>
      <trans-unit id="h113" resname="holiday.error.shift_to_workday">
        <source>holiday.error.shift_to_workday</source>
        <target>The target day is already a workday.</target>
      </trans-unit>
      <trans-unit id="h114" resname="holiday.error.shift_to_holiday">
        <source>holiday.error.shift_to_holiday</source>
        <target>The target day is a public holiday.</target>
      </trans-unit>
      <trans-unit id="h115" resname="holiday.error.shift_to_outside_contract">
        <source>holiday.error.shift_to_outside_contract</source>
        <target>The target day is outside the work contract.</target>
      </trans-unit>
      <trans-unit id="h116" resname="holiday.error.shift_to_taken">
        <source>holiday.error.shift_to_taken</source>
        <target>The target day already has a shift.</target>
      </trans-unit>
      <trans-unit id="h117" resname="holiday.error.shift_no_location">
        <source>holiday.error.shift_no_location</source>
        <target>You are not assigned to a location.</target>
      </trans-unit>
      <trans-unit id="h118" resname="holiday.error.shift_to_closed">
        <source>holiday.error.shift_to_closed</source>
        <target>The location is closed on the target day.</target>
      </trans-unit>
      <trans-unit id="h119" resname="holiday.error.shift_absent">
        <source>holiday.error.shift_absent</source>
        <target>An approved absence exists on one of the days.</target>
      </trans-unit>
      <trans-unit id="h120" resname="holiday.error.shift_target_extra">
        <source>holiday.error.shift_target_extra</source>
        <target>An extra shift exists on the target day.</target>
      </trans-unit>
      <trans-unit id="h121" resname="holiday.error.shift_locked">
        <source>holiday.error.shift_locked</source>
        <target>The period is locked.</target>
      </trans-unit>
      <trans-unit id="h122" resname="holiday.error.shift_has_absence">
        <source>holiday.error.shift_has_absence</source>
        <target>An approved absence exists on the source or target day.</target>
      </trans-unit>
      <trans-unit id="h123" resname="holiday.error.shift_not_approved">
        <source>holiday.error.shift_not_approved</source>
        <target>Only an approved day shift can be set back to requested.</target>
      </trans-unit>
      <trans-unit id="h124" resname="holiday.shift.created">
        <source>holiday.shift.created</source>
        <target>Day shift saved.</target>
      </trans-unit>
    </body>
