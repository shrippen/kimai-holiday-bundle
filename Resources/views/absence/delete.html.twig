{% extends kimai_context.modalRequest ? 'form.html.twig' : 'base.html.twig' %}

{% block main %}
    {% set name = absence.type.label|trans ~ ' · ' ~ absence.startDate|date_short %}
    {% if absence.endDate != absence.startDate %}
        {% set name = name ~ ' – ' ~ absence.endDate|date_short %}
    {% endif %}
    {% if absence.user != app.user %}
        {% set name = absence.user.displayName ~ ' · ' ~ name %}
    {% endif %}
    {{ include(kimai_context.modalRequest ? 'default/_form_delete_modal.html.twig' : 'default/_form_delete.html.twig', {
        message: 'holiday.absence.delete_message'|trans,
        form: form,
        delete_item_name: name,
        used: true,
        back: back,
    }) }}
{% endblock %}
