{% extends kimai_context.modalRequest ? 'form.html.twig' : 'base.html.twig' %}

{% block main %}
    {% set formTemplate = kimai_context.modalRequest ? 'default/_form_modal.html.twig' : 'default/_form.html.twig' %}
    {% set title = (absence.id is null ? 'holiday.absence.create' : 'holiday.absence.edit')|trans %}
    {% if target_user is not null and target_user != app.user %}
        {% set title = title ~ ' · ' ~ target_user.displayName %}
    {% endif %}
    {% embed formTemplate with {title: title, form: form, back: back, reset: false} %}
        {% form_theme form 'form/horizontal.html.twig' %}
        {% block form_body %}
            {% if absence.id is not null and absence.status.value == 'approved' %}
                {% from '@theme/components/alert.html.twig' import alert %}
                {{ alert({type: 'info', description: 'holiday.absence.edit.help'|trans, icon: 'info', dismissible: false, important: false}) }}
            {% endif %}
            {{ form_row(form.type) }}
            {{ form_row(form.startDate) }}
            {{ form_row(form.endDate) }}
            {{ form_row(form.halfDay) }}
            {{ form_row(form.duration) }}
            {{ form_row(form.comment) }}
            {{ form_rest(form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
