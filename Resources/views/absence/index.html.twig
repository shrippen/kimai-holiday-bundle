{% extends 'datatable.html.twig' %}
{% import '@Holiday/_kit/macros.html.twig' as kit %}
{% import 'macros/widgets.html.twig' as widgets %}

{% set status_keys = {new: 'open', requested: 'requested', approved: 'approved', rejected: 'rejected'} %}
{% set bulk_form = 'holiday-absence-bulk' %}

{% block stylesheets %}{{ parent() }}{% include '@Holiday/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Holiday/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% block page_intro %}
    {{ kit.context_line([target_user.displayName, year]) }}
    {{ parent() }}
{% endblock %}

{% block table_actions %}
    <div class="d-flex flex-wrap align-items-center gap-2">
        {{ kit.period_nav(['year'], 'year', year, period.prev, period.next, period.today, {}) }}
        {% if user_form is not null %}
            {{ form_start(user_form, {attr: {class: 'holiday-filter', 'data-holiday-autosubmit': '1'}}) }}
                {{ form_widget(user_form.user) }}
            {{ form_end(user_form) }}
        {% endif %}
        {{ parent() }}
    </div>
{% endblock %}

{% block page_content_start %}
    {{ kit.result_callouts() }}
    {{ parent() }}
{% endblock %}

{% block datatable_row_attr %}
    {%- if can_create %} class="modal-ajax-form open-edit" data-href="{{ path('holiday_absence_edit', {id: entry.id}) }}"{% endif -%}
{% endblock %}

{% block datatable_column_value %}
    {% if column == 'select' %}
        {% if entry.status.value == 'requested' %}
            {{ kit.bulk_checkbox(bulk_form, entry.id) }}
        {% endif %}
    {% elseif column == 'type' %}
        <i class="{{ entry.type.icon|icon }} fa-fw me-1" aria-hidden="true"></i>{{ entry.type.label|trans }}
    {% elseif column == 'period' %}
        <i class="{{ entry.type.icon|icon }} fa-fw me-1 d-md-none" title="{{ entry.type.label|trans }}"></i>
        <span class="kpu-num">{{ entry.startDate|date_short }}{% if entry.endDate != entry.startDate %} – {{ entry.endDate|date_short }}{% endif %}</span>
    {% elseif column == 'days' %}
        <span class="kpu-num">{{ (absence_days[entry.id] ?? 0)|amount }}</span>
    {% elseif column == 'half_day' %}
        {{ widgets.label_boolean(entry.halfDay) }}
    {% elseif column == 'comment' %}
        {{ entry.comment }}
    {% elseif column == 'status' %}
        {{ kit.status_badge(status_keys[entry.status.value] ?? 'open') }}
    {% elseif column == 'actions' %}
        {% set event = actions(app.user, 'holiday_absence', 'index', {absence: entry}) %}
        {{ widgets.table_actions(event.actions) }}
    {% endif %}
{% endblock %}

{% block main %}
    {% set contract_url = (is_granted('contract_other_profile') or target_user == app.user) ? path('user_profile_contract', {username: target_user.userIdentifier}) : null %}
    {{ kit.kpi_bar([
        {label: 'holiday.kpi.vacation_taken'|trans, value: kpi.taken|amount, hint: 'days'|trans},
        {label: 'holiday.kpi.vacation_requested'|trans, value: kpi.requested|amount, hint: 'days'|trans},
        {label: 'holiday.kpi.sick_days'|trans, value: kpi.sick|amount, hint: 'days'|trans},
        {label: 'holiday.kpi.vacation_left'|trans, value: kpi.left|amount, hint: 'holiday.kpi.of_entitlement'|trans({'%days%': kpi.entitlement|amount}), highlight: true, url: contract_url},
    ]) }}

    {% if not dataTable.hasResults() %}
        {{ kit.empty_state(
            'holiday.absence.empty_year'|trans({'%year%': year}),
            can_create ? path('holiday_absence_create', {user: user_param}) : null,
            can_create ? 'holiday.absence.create'|trans : null,
            'modal-ajax-form'
        ) }}
    {% else %}
        {{ parent() }}
        {% if bulk_enabled %}
            {{ kit.bulk_bar(bulk_form, [
                {label: 'approve'|trans, url: path('holiday_absence_bulk_approve'), token: csrf_token('holiday_absence_action'), icon: 'success', ajax: true},
                {label: 'reject'|trans, url: path('holiday_absence_bulk_reject'), token: csrf_token('holiday_absence_action'), icon: 'rejected', class: '', ajax: true},
            ]) }}
        {% endif %}
    {% endif %}
{% endblock %}
