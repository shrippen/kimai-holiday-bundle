{% extends 'base.html.twig' %}
{% import '@Holiday/_kit/macros.html.twig' as kit %}

{% block stylesheets %}{{ parent() }}{% include '@Holiday/_assets.html.twig' with {part: 'css'} %}{% endblock %}

{% block page_intro %}
    {{ kit.context_line([target_user.displayName]) }}
    {{ parent() }}
{% endblock %}

{% block main %}
    {% embed 'default/_form.html.twig' with {title: 'holiday.booking.create'|trans, form: form, back: back, reset: false} %}
        {% form_theme form 'form/horizontal.html.twig' %}
    {% endembed %}
{% endblock %}
