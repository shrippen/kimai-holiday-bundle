{% extends kimai_context.modalRequest ? 'form.html.twig' : 'base.html.twig' %}

{% block main %}
    {% if subject.date is defined %}
        {% set name = subject.name ~ ' · ' ~ subject.date|date_short %}
    {% else %}
        {% set name = subject.name %}
    {% endif %}
    {{ include(kimai_context.modalRequest ? 'default/_form_delete_modal.html.twig' : 'default/_form_delete.html.twig', {
        message: message|trans,
        form: form,
        delete_item_name: name,
        used: true,
        back: back,
    }) }}
{% endblock %}
