{% extends 'base.html.twig' %}
{% import '@Holiday/_kit/macros.html.twig' as kit %}
{% import 'macros/widgets.html.twig' as widgets %}
{% import 'macros/datatables.html.twig' as tables %}

{% block stylesheets %}{{ parent() }}{% include '@Holiday/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Holiday/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% block page_intro %}
    {{ kit.context_line([group ? group.name : null, year]) }}
    {{ parent() }}
{% endblock %}

{% block table_actions %}
    {{ kit.period_nav(['year'], 'year', year, period.prev, period.next, period.today, {}) }}
{% endblock %}

{% block page_content_start %}
    {{ kit.result_callouts() }}
    {{ parent() }}
{% endblock %}

{% block main %}
    {% if groups is empty %}
        {{ kit.empty_state('holiday.public_holiday.create_group_first'|trans, path('holiday_public_holiday_group_create'), 'holiday.public_holiday.create_group'|trans, 'modal-ajax-form') }}
    {% else %}
    <div class="row row-cards">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">{{ 'holiday.public_holiday.groups'|trans }}</h3>
                </div>
                <div class="list-group list-group-flush">
                    {% for g in groups %}
                        {% set active = group and group.id == g.id %}
                        <div class="list-group-item d-flex align-items-center gap-2{% if active %} active{% endif %}">
                            <a href="{{ path('holiday_public_holidays', {year: year, group: g.id}) }}" class="flex-fill text-reset text-truncate{% if active %} fw-bold{% endif %}"{% if active %} aria-current="true"{% endif %}>
                                {{ g.name }}
                                {% if g.country %}<span class="text-body-secondary ms-1">{{ g.country }}{% if g.region %}-{{ g.region }}{% endif %}</span>{% endif %}
                            </a>
                            {% if g.icsUrl %}<span class="text-body-secondary" title="{{ 'holiday.public_holiday.subscribed'|trans }}">{{ icon('link', true) }}</span>{% endif %}
                            {{ widgets.table_actions({
                                trash: {url: path('holiday_public_holiday_group_delete', {id: g.id}), class: 'modal-ajax-form text-red', title: 'trash'},
                            }) }}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="col-md-8">
            {% if holidays is empty %}
                {{ kit.empty_state(
                    'holiday.public_holiday.empty'|trans({'%year%': year}),
                    path('holiday_public_holiday_import', {id: group.id, year: year}),
                    'holiday.public_holiday.import'|trans,
                    'modal-ajax-form'
                ) }}
            {% else %}
                {% set columns = {
                    'date': {class: 'alwaysVisible w-min', orderBy: false, title: 'holiday.public_holiday.date'},
                    'name': {class: 'alwaysVisible', orderBy: false, title: 'holiday.public_holiday.name'},
                    'half_day': {class: 'text-center w-min', orderBy: false, title: 'holiday.public_holiday.half_day'},
                    'actions': {class: 'actions alwaysVisible', orderBy: false},
                } %}
                {{ tables.datatable_header('holiday_public_holidays', columns, null, {columnConfig: false, sticky: false}) }}
                    {% for h in holidays %}
                        <tr>
                            <td class="{{ datatable_column_class('holiday_public_holidays', 'date') }} text-nowrap kpu-num">{{ h.date|date_short }}</td>
                            <td class="{{ datatable_column_class('holiday_public_holidays', 'name') }}">{{ h.name }}</td>
                            <td class="{{ datatable_column_class('holiday_public_holidays', 'half_day') }}">{{ widgets.label_boolean(h.halfDay) }}</td>
                            <td class="{{ datatable_column_class('holiday_public_holidays', 'actions') }}">
                                {{ widgets.table_actions({
                                    trash: {url: path('holiday_public_holiday_delete', {id: h.id}), class: 'modal-ajax-form text-red', title: 'trash'},
                                }) }}
                            </td>
                        </tr>
                    {% endfor %}
                {{ tables.data_table_footer(null, null, null) }}
            {% endif %}
        </div>
    </div>
    {% endif %}
{% endblock %}
