{% extends 'base.html.twig' %}

{% block page_content %}
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="mb-0">{{ 'menu.absence_calendar'|trans }} — {{ year }}</h2>
        <div>
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('holiday_absence_calendar', {year: year - 1, team: selected_team ?: null}) }}">&laquo; {{ year - 1 }}</a>
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('holiday_absence_calendar', {year: year + 1, team: selected_team ?: null}) }}">{{ year + 1 }} &raquo;</a>
        </div>
    </div>

    {% if teams is not empty %}
        <form method="get" class="mb-3">
            <label class="me-1">{{ 'label.team'|trans }}</label>
            <select name="team" class="form-select w-auto d-inline-block" onchange="this.form.submit()">
                <option value="0">—</option>
                {% for t in teams %}
                    <option value="{{ t.id }}" {% if selected_team == t.id %}selected{% endif %}>{{ t.name }}</option>
                {% endfor %}
            </select>
        </form>
    {% endif %}

    <p class="text-muted small mb-3">
        {% for item in type_legend %}
            <span class="me-3">
                <i class="{{ item.icon|icon }}"></i>
                {{ item.label|trans }}
            </span>
        {% endfor %}
    </p>

    {% for monthNum, month in months %}
        <div class="card mb-3">
            <div class="card-header">{{ month.date|month_name }} {{ year }}</div>
            <div class="card-body p-0 table-responsive">
                <table class="table table-bordered table-sm mb-0 absence-calendar-month">
                    <thead>
                        <tr>
                            <th class="text-nowrap">{{ 'label.user'|trans }}</th>
                            {% for day in 1..month.daysInMonth %}
                                <th class="text-center px-1">{{ day }}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in month.grid %}
                            <tr>
                                <td class="text-nowrap">{{ row.user.displayName }}</td>
                                {% for day in 1..month.daysInMonth %}
                                    <td class="text-center align-middle px-0">
                                        {% if row.days[day] is defined %}
                                            {% for entry in row.days[day] %}
                                                <i class="{{ entry.icon|icon }} fa-xs" title="{{ entry.label|trans }}"></i>
                                            {% endfor %}
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{{ month.daysInMonth + 1 }}" class="text-muted">{{ 'absence.empty'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endfor %}
{% endblock %}
