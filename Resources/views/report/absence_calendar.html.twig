{% extends 'base.html.twig' %}
{% import '@Holiday/_kit/macros.html.twig' as kit %}

{% block stylesheets %}{{ parent() }}{% include '@Holiday/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Holiday/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% set period_label = month is null ? year : month_date|month_name(true) %}

{% block page_intro %}
    {{ kit.context_line([selected_team ? selected_team.name : null, period_label]) }}
    {{ parent() }}
{% endblock %}

{% block table_actions %}
    <div class="d-flex flex-wrap align-items-center gap-2">
        {{ kit.period_nav(['month', 'year'], period.unit, period_label, period.prev, period.next, period.today, period.units) }}
        {% if team_form is not null %}
            {{ form_start(team_form, {attr: {class: 'holiday-filter', 'data-holiday-autosubmit': '1'}}) }}
                {{ form_widget(team_form.team) }}
            {{ form_end(team_form) }}
        {% endif %}
    </div>
{% endblock %}

{% block main %}
    <div class="card mb-3">
        <div class="card-body py-2 d-flex flex-wrap align-items-center gap-3 text-body-secondary">
            {% for item in type_legend %}
                <span class="text-nowrap"><i class="{{ item.icon|icon }} fa-fw" aria-hidden="true"></i> {{ item.label|trans }}</span>
            {% endfor %}
            <span class="text-nowrap"><i class="{{ 'holiday'|icon }} fa-fw" aria-hidden="true"></i> {{ kit.status_badge('approved') }}</span>
            <span class="text-nowrap"><span class="opacity-50"><i class="{{ 'holiday'|icon }} fa-fw" aria-hidden="true"></i></span> {{ kit.status_badge('requested') }}</span>
        </div>
    </div>

    {% for monthNum, m in months %}
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">
                    {% if month is null %}
                        <a class="text-reset" href="{{ path('holiday_absence_calendar_month', {year: year, month: monthNum, team: selected_team ? selected_team.id : null}) }}">{{ m.date|month_name(true) }}</a>
                    {% else %}
                        {{ m.date|month_name(true) }}
                    {% endif %}
                </h3>
            </div>
            {% if m.grid is empty %}
                <div class="card-body">
                    {{ kit.empty_state('holiday.calendar.no_users'|trans) }}
                </div>
            {% else %}
                <div class="card-body p-0 table-responsive">
                    <table class="table table-bordered table-sm mb-0 holiday-calendar">
                        <thead>
                            <tr>
                                <th class="text-nowrap">{{ 'user'|trans }}</th>
                                {% for day in 1..m.daysInMonth %}
                                    <th class="text-center px-1{% if m.weekend[day] %} bg-secondary-lt{% endif %}">{{ day }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in m.grid %}
                                <tr>
                                    <td class="text-nowrap">{{ row.user.displayName }}</td>
                                    {% for day in 1..m.daysInMonth %}
                                        <td class="text-center align-middle px-0{% if m.weekend[day] %} bg-secondary-lt{% endif %}">
                                            {% for entry in row.days[day] ?? [] %}
                                                {% set title = entry.label|trans ~ ' · ' ~ (entry.requested ? 'kpu.status.requested' : 'kpu.status.approved')|trans({}, 'kpu') %}
                                                <span class="{{ entry.requested ? 'opacity-50' : '' }}" data-toggle="tooltip" title="{{ title }}" aria-label="{{ title }}"><i class="{{ entry.icon|icon }} fa-xs"></i></span>
                                            {% endfor %}
                                        </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    {% endfor %}
{% endblock %}
