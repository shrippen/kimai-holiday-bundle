{% extends 'base.html.twig' %}
{% import '@Holiday/_kit/macros.html.twig' as kit %}

{% block stylesheets %}{{ parent() }}{% include '@Holiday/_assets.html.twig' with {part: 'css'} %}{% endblock %}
{% block javascripts %}{{ parent() }}{% include '@Holiday/_assets.html.twig' with {part: 'js'} %}{% endblock %}

{% set period_label = month is null ? year : month_date|month_name(true) %}

{% block page_intro %}
    {{ kit.context_line([selected_team ? selected_team.name : null, period_label]) }}
    {{ parent() }}
{% endblock %}

{% block table_actions %}
    <div class="d-flex flex-wrap align-items-center gap-2">
        {{ kit.period_nav(['month', 'year'], period.unit, period_label, period.prev, period.next, period.today, period.units) }}
        {% if team_form is not null %}
            {{ form_start(team_form, {attr: {class: 'holiday-filter', 'data-holiday-autosubmit': '1'}}) }}
                {{ form_widget(team_form.team) }}
            {{ form_end(team_form) }}
        {% endif %}
    </div>
{% endblock %}

{% block main %}
    {# Legend: types by icon, day marks as the kit's calendar days (absence bar, public holiday bar, today) #}
    <div class="card mb-3">
        <div class="card-body py-2 d-flex flex-wrap align-items-center gap-3 text-body-secondary">
            {% for item in type_legend %}
                <span class="text-nowrap"><i class="{{ item.icon|icon }} fa-fw" aria-hidden="true"></i> {{ item.label|trans }}</span>
            {% endfor %}
            <div class="d-flex align-items-center gap-1 text-nowrap">{{ kit.calendar_day('01', {absence: true}) }} {{ kit.status_badge('approved') }}</div>
            <div class="d-flex align-items-center gap-1 text-nowrap"><span class="opacity-50"><i class="{{ 'holiday'|icon }} fa-fw" aria-hidden="true"></i></span> {{ kit.status_badge('requested') }}</div>
            <div class="d-flex align-items-center gap-1 text-nowrap">{{ kit.calendar_day('01', {holiday: true}) }} {{ 'kpu.day.holiday'|trans({}, 'kpu') }}</div>
            <div class="d-flex align-items-center gap-1 text-nowrap">{{ kit.calendar_day('01', {today: true}) }} {{ 'kpu.day.today'|trans({}, 'kpu') }}</div>
        </div>
    </div>

    {% for monthNum, m in months %}
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">
                    {% if month is null %}
                        <a class="text-reset" href="{{ path('holiday_absence_calendar_month', {year: year, month: monthNum, team: selected_team ? selected_team.id : null}) }}">{{ m.date|month_name(true) }}</a>
                    {% else %}
                        {{ m.date|month_name(true) }}
                    {% endif %}
                </h3>
            </div>
            {% if m.grid is empty %}
                <div class="card-body">
                    {{ kit.empty_state('holiday.calendar.no_users'|trans) }}
                </div>
            {% else %}
                <div class="card-body p-0 table-responsive">
                    <table class="table table-bordered table-sm mb-0 holiday-calendar">
                        <thead>
                            <tr>
                                <th class="text-nowrap">{{ 'user'|trans }}</th>
                                {# Two-digit days (as Kimai's working times) keep the columns equally wide #}
                                {% for day in 1..m.daysInMonth %}
                                    {{ kit.calendar_day('%02d'|format(day), {tag: 'td', today: day == m.today, weekend: m.weekend[day]}) }}
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in m.grid %}
                                <tr>
                                    <td class="text-nowrap">{{ row.user.displayName }}</td>
                                    {% for day in 1..m.daysInMonth %}
                                        {# Bar for approved absences and the user's public holidays; requested absences only as faded icon #}
                                        {% set entries = row.days[day] ?? [] %}
                                        {% set holiday = row.holidays[day] ?? null %}
                                        {% set labels = entries|map(e => e.label|trans ~ ' · ' ~ (e.requested ? 'kpu.status.requested' : 'kpu.status.approved')|trans({}, 'kpu')) %}
                                        {% set icons %}
                                            {%- for entry in entries -%}
                                                <i class="{{ entry.icon|icon }} fa-xs{{ entry.requested ? ' opacity-50' : '' }}" aria-hidden="true"></i>
                                            {%- endfor -%}
                                        {% endset %}
                                        {{ kit.calendar_day('', {
                                            tag: 'td',
                                            today: day == m.today,
                                            weekend: m.weekend[day],
                                            holiday: holiday is not null,
                                            absence: entries|filter(e => not e.requested) is not empty,
                                            label: (holiday is not null ? [holiday] : [])|merge(labels)|join(', ') ?: null,
                                            content: entries is empty ? null : icons,
                                        }) }}
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    {% endfor %}
{% endblock %}
